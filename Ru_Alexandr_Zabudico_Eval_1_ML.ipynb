    "## 7. Градиентный спуск (Gradient Descent)\n",
    "1. Реализуйте алгоритм градиентного спуска вручную для оптимизации заданной функции стоимости.\n",
    "2. Используйте простую функцию $$J(\\theta) = (\\theta x - y)^2$$ на подмножестве данных."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "e86ad456",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "theta (градиентный спуск) = 0.08851\n",
      "theta (аналитически)      = 0.08851\n",
      "J(theta) = 0.99217\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# подмножество данных: 200 объектов, x и y — стандартизированные числовые признаки\n",
    "sub = df.sample(200, random_state=42)\n",
    "x = sub[\"tBodyAcc-mean()-X\"].values\n",
    "yv = sub[\"tBodyAcc-max()-X\"].values\n",
    "x = (x - x.mean()) / x.std()\n",
    "yv = (yv - yv.mean()) / yv.std()\n",
    "\n",
    "# J(theta) = mean((theta*x - y)^2),  dJ/dtheta = mean(2*x*(theta*x - y))\n",
    "def cost(theta):\n",
    "    return np.mean((theta * x - yv) ** 2)\n",
    "\n",
    "def grad(theta):\n",
    "    return np.mean(2 * x * (theta * x - yv))\n",
    "\n",
    "theta, lr, history = 0.0, 0.1, []\n",
    "for i in range(100):\n",
    "    theta -= lr * grad(theta)\n",
    "    history.append(cost(theta))\n",
    "\n",
    "theta_exact = (x @ yv) / (x @ x)   # аналитическое решение\n",
    "print(f\"theta (градиентный спуск) = {theta:.5f}\")\n",
    "print(f\"theta (аналитически)      = {theta_exact:.5f}\")\n",
    "print(f\"J(theta) = {history[-1]:.5f}\")\n",
    "\n",
    "plt.plot(history)\n",
    "plt.xlabel(\"Итерация\"); plt.ylabel(\"J(theta)\"); plt.title(\"Сходимость градиентного спуска\")\n",
    "plt.show()"
   ]
  },
